# Willwin v11 — environment template
# Copy to .env.local for local dev, and set the same keys in the Vercel
# dashboard for production. NEXT_PUBLIC_* vars are exposed to the browser
# bundle; everything else is server-only.

# ─── Admin gate ────────────────────────────────────────────────────────
# Shared password for the admin SPA (single-tenant MVP). The /login route
# compares against this and sets the willwin_session cookie on match.
ADMIN_PASSWORD=change-me-before-deploy

# ─── Supabase ─────────────────────────────────────────────────────────
# Project URL and anon key. The admin SPA uses both directly; n8n should
# use the SERVICE_ROLE key (server-side only — DO NOT put it here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── n8n webhooks ─────────────────────────────────────────────────────
# Base URL of the n8n instance. The booking flow appends
# /webhook/willwin/booking/{init,availability,create,get}.
# No trailing slash.
NEXT_PUBLIC_N8N_BASE_URL=https://n8n.example.com

# ─── Site URL (used by /api/auth/logout redirect only) ───────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─── Google Sheets ledger sync (optional) ─────────────────────────────
# Server-only. If unset, ledger sync silently no-ops. The service account
# must have edit access to the sheet.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key including the BEGIN/END markers. In Vercel
# you can paste it as-is (with newlines). For .env.local, escape newlines
# as \n in a single line.
GOOGLE_PRIVATE_KEY=
